# ==========================================
# NOVA SUPPLY - Environment Configuration
# CODSOFT Web Development Internship Level 3
# ==========================================

# Server Port (default 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String
# Leave empty to operate in DEMO MODE (authoritative in-memory data store with pre-seeded data)
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nova_supply?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for token signing and verification
JWT_SECRET=nova-supply-super-secret-jwt-key-2026

# Client URL for CORS origin (optional)
CLIENT_URL=http://localhost:5173
